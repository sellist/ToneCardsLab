# Environment variables for ToneCards Lab API

# Application settings
APP_NAME="ToneCards Lab API"
APP_VERSION=0.1.0
DEBUG=true

# API configuration
API_PREFIX=/api/v1

# CORS origins (comma-separated)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Server settings
HOST=0.0.0.0
PORT=8000

